#!/bin/bash

# Ensure container exists
CONTAINER_ID=$(podman ps -a --filter name=apx-vso-native --no-trunc -q)
if [ -z "$CONTAINER_ID" ]; then
    vso native init
    exit
fi

mkdir -p ~/.config/alacritty

tee ~/.config/alacritty/vso.toml >/dev/null <<'EOF'
[shell]
program = "distrobox-enter"
args = ["apx-vso-native"]
EOF